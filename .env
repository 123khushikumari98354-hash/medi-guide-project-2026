# true  = run with built-in demo data (no backend needed)  |  in this full-stack project it is false
# false = call the Express API (start the server first; Vite proxies /api to http://localhost:5000)
VITE_USE_MOCK=false
# Optional: full API address when the backend is hosted elsewhere
# VITE_API_URL=https://your-server.example.com/api
